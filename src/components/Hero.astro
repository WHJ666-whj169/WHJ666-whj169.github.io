 */
import {siteConfig} from "../config";
---
<section id="hero" class="space-hero" aria-labelledby="hero-title">
  <div class="gateway" aria-hidden="true"></div>
  <video class="space-video" muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"><source src="/space/blackhole.webm" type="video/webm"/></video>
  <canvas id="star-field" aria-hidden="true"></canvas>
  <div class="space-hero-inner">
    <div class="space-copy"><span class="space-label"><span>✧</span> A SMALL CORNER, AN ENDLESS UNIVERSE</span>
      <p class="space-greeting">你好，我是 {siteConfig.name}。</p>
      <h1 id="hero-title">让想法，<br/>在这里<span>发光。</span></h1>
      <p class="space-intro">收集作品，记录探索。<br/>把每一次好奇，变成看得见的创造。</p>
      <div class="hero-buttons"><a class="primary-button" href="#projects">探索我的作品 <span aria-hidden="true">↗</span></a><a class="secondary-button" href="/notes/">阅读成长记录 →</a></div>
    </div>
    <div class="space-orbit" aria-hidden="true"><div class="orbit-aura"></div><img src="/space/orbit.svg" alt="" width="650" height="650" fetchpriority="high" draggable="false"/><div class="orbit-caption"><span class="orbit-signal"></span> IDEAS · EXPERIMENTS · POSSIBILITIES</div></div>
  </div>
  <div class="hero-bottom-line"><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><span>保持好奇，持续探索。</span><a href="#explore">向下探索 ↓</a></div>
</section>
<script>
  const canvas=document.querySelector<HTMLCanvasElement>('#star-field');
  const hero=document.querySelector<HTMLElement>('.space-hero');
  if(canvas&&hero){
    const context=canvas.getContext('2d');
    if(context){
      const motion=matchMedia('(prefers-reduced-motion: reduce)');
      let width=1,height=1,frame=0,last=0,visible=true;
      let seed=2048;const random=()=>{seed=(seed*16807)%2147483647;return(seed-1)/2147483646;};
      const stars=Array.from({length:175},()=>({x:random(),y:random(),radius:.4+random()*1.1,phase:random()*Math.PI*2,opacity:.18+random()*.6}));
      const draw=(time:number)=>{context.clearRect(0,0,width,height);for(const star of stars){const twinkle=motion.matches?1:.72+.28*Math.sin(time*.0005+star.phase);context.beginPath();context.arc(star.x*width,star.y*height,star.radius,0,Math.PI*2);context.fillStyle='rgba(220,219,255,'+star.opacity*twinkle+')';context.fill();}};
      const tick=(time:number)=>{frame=0;if(!visible||document.hidden||motion.matches){video?.pause();return;}if(time-last>50){draw(time);last=time;}frame=requestAnimationFrame(tick);};
      const video=hero.querySelector<HTMLVideoElement>('video');
      const refresh=()=>{cancelAnimationFrame(frame);draw(0);if(visible&&!document.hidden&&!motion.matches){frame=requestAnimationFrame(tick);video?.play().then(()=>hero.classList.add('has-motion-video')).catch(()=>hero.classList.remove('has-motion-video'));}else{video?.pause();}};
      const resize=()=>{const rect=hero.getBoundingClientRect();width=rect.width;height=rect.height;const dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);context.setTransform(dpr,0,0,dpr,0,0);draw(0);};
      new ResizeObserver(resize).observe(hero);resize();
      new IntersectionObserver(entries=>{visible=entries[0].isIntersecting&&entries[0].intersectionRatio>.01;refresh();},{threshold:[0,.01]}).observe(hero);
      motion.addEventListener('change',refresh);document.addEventListener('visibilitychange',refresh);video?.addEventListener('loadeddata',refresh,{once:true});refresh();
    }
  }
</script>
