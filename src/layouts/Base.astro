---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {siteConfig} from '../config';
import '../styles/global.css';
const {title=siteConfig.title,description=siteConfig.description,home=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#1d4ed8"/><meta name="generator" content={Astro.generator}/><title>{home?'WHJ — 我的个人空间':title+' · WHJ'}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title="WHJ 的成长记录" href="/rss.xml"/><meta property="og:title" content={title+' · WHJ'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/>
<script is:inline>try{const saved=localStorage.getItem('whj-theme');document.documentElement.dataset.theme=saved==='dark'||(!saved&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';}catch{document.documentElement.dataset.theme='light';}</script>
</head><body><a class="skip-link" href="#main">跳转到正文</a><Header home={home}/><slot/><Footer/></body></html>

