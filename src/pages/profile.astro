import Base from '../layouts/Base.astro';
import {siteConfig} from '../config';
---
<Base title="个人档案"><main class="page-shell" id="main"><div class="page-intro"><span class="eyebrow">PERSONAL PROFILE</span><h1>关于 WHJ<span>.</span></h1><p>一个持续更新的公开档案。从作品开始，慢慢让介绍变得具体。</p></div><div class="profile-grid"><section class="profile-card"><div class="avatar" aria-hidden="true">W.</div><h2>WHJ</h2><p>保持好奇，把想法变成作品。</p><a class="inline-link" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></section><section class="prose"><h2>我想留下什么</h2><p>{siteConfig.aboutMe}</p><h2>现在的公开作品</h2><p><a href="/projects/personal-website/">我的个人网站</a>：基于成熟开源模板定制的个人空间。</p><h2>这份档案会如何生长</h2><p>随着作品增加，逐步补充项目经历、创作方向和阶段成果。学校、专业、简历及联系方式等信息，等准备好公开后再添加。</p><a class="secondary-button" href="/#projects">查看作品 →</a></section></div></main></Base>

